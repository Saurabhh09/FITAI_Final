{
  "expo": {
    "name": "FITAI",
    "slug": "fitai-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fitai",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anonymous.fitaimobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "package": "com.anonymous.fitaimobile"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F7FB",
          "image": "./assets/splash-icon.png",
          "imageWidth": 128
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FITAI to access your camera to scan meals and analyze food nutrition."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}