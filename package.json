{
  "name": "fitai",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@11.6.0",
  "workspaces": [
    "apps/mobile",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "serve:legal": "npx http-server Legals -p 3333 -c-1",
    "start": "npx expo start --dev-client",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "lint": "eslint apps/mobile/src",
    "typecheck": "tsc --project apps/mobile/tsconfig.json --noEmit",
    "test": "vitest run apps/mobile packages",
    "test:watch": "vitest apps/mobile packages",
    "postinstall": "node scripts/patch-expo-cli.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.105.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@trigger.dev/sdk": "^4.8.1",
    "@types/node": "^20.19.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "import-in-the-middle": "^3.5.3",
    "require-in-the-middle": "^8.0.1",
    "trigger.dev": "^4.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "4.1.11"
  }
}