{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@fitai/nutrition-engine": [
        "./packages/nutrition-engine/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "scripts/**/*.js",
    "**/*.mts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "trigger.config.ts"
  ],
  "exclude": [
    "node_modules",
    "uploads"
  ],
  "extends": "expo/tsconfig.base"
}